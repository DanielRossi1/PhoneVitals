{
  "_note": [
    "Catalogue of expected specifications, used only for indicative comparisons.",
    "Discrepancies raise 'warning' findings, never 'critical': a wrong entry",
    "here would produce a false counterfeit alarm.",
    "Fields are deliberately omitted where they vary by market or by batch",
    "(for example the core count of the Galaxy S24, which ships an Exynos 2400",
    "with 10 cores in Europe and an 8-core Snapdragon 8 Gen 3 elsewhere).",
    "The camera_count field is left unpopulated on purpose: the number of",
    "cameras the API exposes varies with logical and hidden cameras, and is",
    "not reliably comparable with the physical lenses.",
    "To extend the catalogue, just add entries to this list."
  ],
  "_schema": {
    "name": "commercial name shown in the report",
    "brand": "expected brand",
    "devices": "board codenames (ro.product.device)",
    "models": "commercial models (ro.product.model). Matched exactly; an entry without spaces, such as a part number (SM-S911), also matches as a prefix (SM-S911B, SM-S911B/DS)",
    "soc": "expected chip",
    "cpu_cores": "number of physical cores",
    "ram_gb": "RAM sizes produced",
    "storage_gb": "storage sizes produced",
    "resolution": "native panel resolution",
    "max_refresh_hz": "maximum refresh rate",
    "confidence": "high | medium | low",
    "soc_ids": "technical chip designations as the system declares them (ro.soc.model, ro.board.platform, kernel Hardware line). The comparison uses only these: the commercial name never appears in the properties.",
    "security_updates_until": "year and month until which the manufacturer guarantees security updates at the least (its published update policy); omit when not known for certain",
    "wifi_only_models": "models of the entry without a mobile radio (Wi-Fi-only tablets), matched like models; the others are expected to have one"
  },
